# Copie para .env e ajuste. O .env nunca vai para o git.

# Chave que a UI manda no cabeçalho x-api-key (a mesma de VITE_API_KEY em apps/ui/.env). Gere com:
#   openssl rand -hex 24
API_KEY=troque-por-uma-chave-longa

# Senha de acesso ao app (mínimo 8 caracteres).
APP_SENHA=troque-por-uma-senha-forte

PORT=3333
# Banco SQLite e pasta dos PDFs dos boletos, relativos a apps/api.
DB_PATH=../../data/financas.db
BOLETOS_DIR=../../boletos

# Atrás de um proxy com HTTPS (Caddy, Nginx...): usa o IP real e marca o cookie como Secure.
# TRUST_PROXY=1
