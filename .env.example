# Copie para .env e ajuste. O .env nunca deve ir para o git.

# Senha para entrar no app (obrigatória, mínimo 8 caracteres)
APP_SENHA=troque-por-uma-senha-forte

# Porta e arquivo do banco
PORT=3000
DB_PATH=data/financas.db

# Quando estiver atrás de um proxy com HTTPS (Railway, Fly, Render, Nginx, Caddy...)
# TRUST_PROXY=1
